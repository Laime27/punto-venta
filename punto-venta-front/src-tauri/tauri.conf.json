{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Punto de Venta",
  "version": "0.1.0",
  "identifier": "com.laimedev.puntodeventa",

  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Punto de Venta",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources": {
      "resources/php": "php/",
      "resources/laravel-backend": "laravel-backend/"
    }
  }
}
