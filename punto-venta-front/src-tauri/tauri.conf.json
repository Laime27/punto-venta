{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Punto de Venta",
  "version": "0.1.0",
  "identifier": "com.laimedev.puntodeventa",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Punto de Venta",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "maximized": true,
        "visible": false
      },
      {
        "label": "carga",
        "title": "Punto de Venta",
        "url": "carga.html",
        "width": 460,
        "height": 240,
        "center": true,
        "resizable": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources": {
      "resources/php": "php/",
      "resources/laravel-backend": "laravel-backend/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
